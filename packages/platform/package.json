{
  "name": "@cx-orbit/platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CX-ORBIT service runtime kit: config, logging, metrics, HTTP server, event bus and Redis helpers.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.spec.json",
    "test": "vitest run",
    "test:unit": "vitest run --exclude '**/idempotency.integration.test.ts'",
    "test:integration": "RUN_INTEGRATION=1 vitest run test/idempotency.integration.test.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cx-orbit/shared": "workspace:*",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "mongodb": "^6.12.0",
    "nats": "^2.29.1",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "vitest": "^2.1.8"
  }
}
