# =====================================================================
# CX-ORBIT — Example environment configuration
# Copy to `.env` and adjust as needed. NEVER commit a real `.env`.
# =====================================================================

# ---- Global ----
NODE_ENV=development
LOG_LEVEL=info

# ---- Infrastructure (Docker Compose service hostnames) ----
# Mongo runs as a single-node replica set (for ACID transactions / Outbox).
# `directConnection=true` avoids replica-set host advertisement issues.
# Host-run services use the localhost default (mongodb://localhost:27017/cxorbit?directConnection=true).
MONGO_URI=mongodb://mongo:27017/cxorbit?directConnection=true
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=cxorbit
POSTGRES_PASSWORD=cxorbit
POSTGRES_DB=cxorbit
REDIS_URL=redis://redis:6379
NATS_URL=nats://nats:4222
# Host-run services connect to Postgres via the mapped host port (POSTGRES_HOST_PORT).
POSTGRES_URL=postgresql://cxorbit:cxorbit@localhost:5433/cxorbit

# ---- Infrastructure host port mappings (Docker Compose) ----
# These map container ports to the host. Change them if a port is already
# taken locally (e.g. a local Postgres on 5432 → set POSTGRES_HOST_PORT=5433).
# Internal service-to-service connections always use the in-network ports above.
MONGO_PORT=27017
POSTGRES_HOST_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
LOKI_PORT=3100

# ---- Event Bus (NATS JetStream) ----
NATS_STREAM=CXORBIT
NATS_MAX_DELIVER=5

# ---- Observability ----
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_URL=http://loki:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_ENABLED=false

# ---- Channel Gateway ----
# When running a service ON THE HOST (pnpm --filter ... dev) leave NATS_URL /
# REDIS_URL unset so the localhost defaults apply; the docker hostnames above
# only resolve from inside the compose network.
# Optional: when set, every inbound webhook must send `x-webhook-token: <secret>`.
WEBHOOK_SECRET=
IDEMPOTENCY_TTL_SECONDS=86400

# ---- Service ports (host mapping) ----
CHANNEL_GATEWAY_PORT=8080
CONVERSATION_SERVICE_PORT=8081
CUSTOMER_SERVICE_PORT=8082
AI_SERVICE_PORT=8083
ROUTING_SERVICE_PORT=8084
OUTBOUND_SERVICE_PORT=8085
ANALYTICS_SERVICE_PORT=8086
INCIDENT_SIMULATOR_PORT=8087
FRONTEND_PORT=3000

# ---- Provider simulator ports ----
WHATSAPP_PROVIDER_PORT=9101
TELEGRAM_PROVIDER_PORT=9102
EMAIL_PROVIDER_PORT=9103
INSTAGRAM_PROVIDER_PORT=9104
FACEBOOK_PROVIDER_PORT=9105
X_PROVIDER_PORT=9106
WEBCHAT_PROVIDER_PORT=9107

# ---- AI provider ----
# One of: mock | openai | anthropic | local
AI_PROVIDER=mock
# Only used when AI_PROVIDER != mock. Leave empty for mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_TIMEOUT_MS=5000
AI_MIN_CONFIDENCE=0.7

# ---- Resilience defaults ----
OUTBOUND_MAX_RETRIES=4
OUTBOUND_BASE_BACKOFF_MS=200
OUTBOUND_TIMEOUT_MS=3000
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
CIRCUIT_BREAKER_MIN_REQUESTS=10
CIRCUIT_BREAKER_RESET_MS=15000
