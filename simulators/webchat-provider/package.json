{
  "name": "@cx-orbit/webchat-provider",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local WebChat provider simulator for CX-ORBIT outbound delivery tests.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
